# cs2-mcp configuration
# Copy this file to .env and adjust as needed. All variables are optional.

# URL of the CS2MCP bridge mod running inside the game.
# Only change the port if you also set CS2MCP_PORT for the game process.
CS2_BRIDGE_URL=http://127.0.0.1:8642

# Optional shared secret sent as the X-CS2MCP-Token header. If the game process
# has CS2MCP_TOKEN set, this must match it or every route except /ping is refused.
# CS2MCP_TOKEN=
